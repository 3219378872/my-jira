# Local development values only. Set independent credentials before public deployment.
DATABASE_URL=postgres://myjira:myjira_local_dev@127.0.0.1:25432/myjira?sslmode=disable
TEST_DATABASE_URL=postgres://myjira:myjira_local_dev@127.0.0.1:25432/myjira_test?sslmode=disable
REDIS_ADDR=127.0.0.1:26379
API_ADDR=127.0.0.1:8088
APP_URL=http://127.0.0.1:4173
APP_ORIGIN=http://127.0.0.1:4173
API_PUBLIC_URL=http://127.0.0.1:4173
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8088
COOKIE_SECURE=false
S3_ENDPOINT=127.0.0.1:29000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:29000
S3_ACCESS_KEY=myjira_local
S3_SECRET_KEY=myjira_local_storage
S3_BUCKET=myjira
S3_USE_SSL=false
SMTP_HOST=127.0.0.1
SMTP_PORT=21025
SMTP_FROM=noreply@myjira.local
LIVE_PORT=3101
LIVE_API_URL=http://127.0.0.1:8088
# Optional: use an existing Chromium instead of the Playwright-managed browser.
CHROMIUM_PATH=
# Optional separate secret; local development falls back to APP_ENCRYPTION_KEY.
LIVE_SERVICE_KEY=
# A separate random 32-byte base64 key encrypts credentials stored via instance settings.
APP_ENCRYPTION_KEY=
AI_PROVIDER=openai
AI_ENABLED=true
AI_BASE_URL=https://api.weblearning.fun/v1
AI_MODEL=gpt-5.6-terra
# Read the API key from this process environment variable; never send it to the browser.
AI_API_KEY_ENV=MINE_API_KEY
# Docker application frontend. A single origin serves the SPA, API and WebSocket.
DEPLOY_ORIGIN=http://127.0.0.1:4180
APP_PORT=4180
# Independent GitHub App used by project quality analysis; not login OAuth.
# Keep the private key and client secret outside source and browser responses.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
